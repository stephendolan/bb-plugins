{
  "name": "bb-plugin-image-copy",
  "version": "0.2.0",
  "description": "Copy an image directly from bb's file preview.",
  "license": "MIT",
  "author": "Stephen Dolan",
  "homepage": "https://github.com/stephendolan/bb-plugins/tree/main/plugins/image-copy#readme",
  "bugs": {
    "url": "https://github.com/stephendolan/bb-plugins/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stephendolan/bb-plugins.git",
    "directory": "plugins/image-copy"
  },
  "type": "module",
  "scripts": {
    "build": "env -u BB_CLI bb plugin build .",
    "check": "npm run types:check && npm run typecheck && npm test && npm run build",
    "dev": "bb plugin dev .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "types:check": "env -u BB_CLI bb plugin types --check .",
    "types:refresh": "env -u BB_CLI bb plugin types ."
  },
  "engines": {
    "bb": ">=0.40",
    "bbPluginSdk": ">=0.4.21"
  },
  "bb": {
    "name": "Image Copy",
    "description": "Copy an image directly from BB's file preview.",
    "branding": {
      "icon": "Copy"
    },
    "server": "./server.ts",
    "app": "./app.tsx"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "^4.1.3",
    "@hugeicons/react": "^1.1.6"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.4.21",
    "@pierre/diffs": "^1.2.9",
    "@radix-ui/react-alert-dialog": "^1.1.19",
    "@radix-ui/react-context-menu": "^2.3.3",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-hover-card": "^1.1.19",
    "@radix-ui/react-menubar": "^1.1.20",
    "@radix-ui/react-navigation-menu": "^1.2.18",
    "@radix-ui/react-popover": "^1.1.19",
    "@radix-ui/react-select": "^2.3.3",
    "@radix-ui/react-tooltip": "^1.2.12",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.2.5",
    "bb-app": "^0.40.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jsdom": "^29.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sonner": "^1.7.4",
    "tailwind-merge": "^3.4.0",
    "typescript": "^5.7.0",
    "vaul": "^1.1.2",
    "vitest": "^4.1.11"
  }
}
