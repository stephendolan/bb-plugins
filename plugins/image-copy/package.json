{
  "name": "bb-plugin-image-copy",
  "version": "0.1.0",
  "description": "Copy an image directly from bb's file preview.",
  "license": "MIT",
  "author": "Stephen Dolan",
  "homepage": "https://github.com/stephendolan/bb-plugins/tree/main/plugins/image-copy#readme",
  "bugs": {
    "url": "https://github.com/stephendolan/bb-plugins/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stephendolan/bb-plugins.git",
    "directory": "plugins/image-copy"
  },
  "type": "module",
  "scripts": {
    "build": "env -u BB_CLI bb plugin build .",
    "check": "npm run types:check && npm run typecheck && npm test && npm run build",
    "dev": "bb plugin dev .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "types:check": "env -u BB_CLI bb plugin types --check .",
    "types:refresh": "env -u BB_CLI bb plugin types ."
  },
  "engines": {
    "bb": ">=0.39",
    "bbPluginSdk": ">=0.4.8"
  },
  "bb": {
    "name": "Image Copy",
    "description": "Copy an image directly from BB's file preview.",
    "branding": {
      "icon": "Copy"
    },
    "server": "./server.ts",
    "app": "./app.tsx"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "^4.1.3",
    "@hugeicons/react": "^1.1.6"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.4.8",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.2.5",
    "bb-app": "^0.39.0",
    "jsdom": "^29.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sonner": "^2.0.8",
    "typescript": "^5.7.0",
    "vitest": "^4.1.11"
  }
}
